<odoo>
    <record id="account_move_form_discount_amount" model="ir.ui.view">
        <field name="name">account.move.line.discount.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="after">
                <field name="discount_amount"/>
            </xpath>

        </field>
    </record>

    <record id="invoice_total_saved" model="ir.ui.view">
        <field name="name">account.move.total.saved</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@widget='account-tax-totals-field']" position="after">
                    <field name="total_discount_amount"
                           string="Total Amount Saved"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"
                           invisible="total_discount_amount == 0"/>
            </xpath>
        </field>
    </record>

</odoo>