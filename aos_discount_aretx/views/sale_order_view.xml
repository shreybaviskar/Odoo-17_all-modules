<odoo>
    <record id="sale_order_form_discount_amount" model="ir.ui.view">
        <field name="name">sale.order.line.discount.amount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="after">
                <field name="discount_amount"/>
            </xpath>

        </field>
    </record>

    <record id="sale_order_total_saved" model="ir.ui.view">
        <field name="name">sale.order.total.saved</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@widget='account-tax-totals-field']" position="after">
                    <field name="total_discount_amount"
                           string="Total Amount Saved"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"
                           invisible="total_discount_amount == 0"/>
            </xpath>
        </field>
    </record>

</odoo>