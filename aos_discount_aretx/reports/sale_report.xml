<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_report_discount_amount"
              inherit_id="sale.report_saleorder_document">

        <!-- Add header -->
        <xpath expr="//th[@name='th_discount']" position="after">
            <th t-if="display_discount" class="text-end">
                Discount Amount
            </th>
        </xpath>

        <!-- Add column value -->
        <xpath expr="//span[@t-field='line.discount']/.." position="after">
            <td t-if="display_discount" class="text-end">
                <t t-if="line.discount_amount &gt; 0">
                    <span t-field="line.discount_amount"
                          t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                </t>
            </td>
        </xpath>

    </template>

</odoo>