<record id="project_view_kanban_inherit_vehicle_details" model="ir.ui.view">
    <field name="name">project.project.kanban.inherit.vehicle.details</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.view_project_kanban"/>
    <field name="arch" type="xml">
        
        <xpath expr="//field[@name='partner_id']" position="after">
            <field name="x_vehicle_brand_name"/>
            <field name="x_vehicle_model_name"/>
            <field name="x_vehicle_reg_number"/>
        </xpath>

        <xpath expr="//span[@t-if='record.partner_id.value']" position="after">
            <div t-if="record.x_vehicle_brand_name.raw_value" class="d-block fw-bold mt-1" style="font-size: 12px;">
                <span class="fa fa-tachometer me-2" title="Brand"></span>
                <t t-esc="record.x_vehicle_brand_name.value"/>  <t t-esc="record.x_vehicle_model_name.value"/>
                
            </div>
            
            <div t-if="record.x_vehicle_reg_number.raw_value" class="d-block fw-bold" style="font-size: 12px;">
                <span class="fa fa-car me-2" title="Vehicle Number"></span>
                <t t-esc="record.x_vehicle_reg_number.value"/>
            </div>
        </xpath>

    </field>
</record>


    <record id="view_task_form2_inherited_vehicle" model="ir.ui.view">
        <field name="name">project.task.form.inherit.vehicle</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_vehicle_brand_name" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True}" />
            </xpath>
        </field>
    </record>

    <record id="view_task_kanban_inherit_vehicle_brand" model="ir.ui.view">
    <field name="name">project.task.kanban.inherit.vehicle</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_kanban"/>
    <field name="arch" type="xml">
        
        <xpath expr="//field[@name='partner_id']" position="after">
            <field name="x_vehicle_brand_name"/>
            <field name="x_vehicle_model_name"/>
            <field name="x_vehicle_reg_number"/>
        </xpath>

        <xpath expr="//span[@t-if='record.partner_id.value']" position="after">
            <div t-if="record.x_vehicle_brand_name.raw_value" class="o_text_overflow fw-bold mt-1" style="font-size: 12px; display: block;">
                <span class="fa fa-tachometer me-2" title="Vehicle Brand"></span>
                <field name="x_vehicle_brand_name"/>  <field name="x_vehicle_model_name"/>
            </div>

            <div t-if="record.x_vehicle_reg_number.raw_value" class="d-block fw-bold" style="font-size: 12px;">
                <span class="fa fa-car me-2" title="Vehicle Number"></span>
                <field name="x_vehicle_reg_number"/>
            </div>
        </xpath>

    </field>
</record>
</odoo>